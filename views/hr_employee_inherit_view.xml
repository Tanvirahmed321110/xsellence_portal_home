<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_inherit_create_user_header" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.create.user.header</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    class="btn-primary"
                    string="Create User"
                    type="object"
                    name="action_create_user"
                />
            </xpath>
        </field>
    </record>
</odoo>