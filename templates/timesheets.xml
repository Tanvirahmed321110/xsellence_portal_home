<odoo>
    <template id="timesheet_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages?v=2"/>
        <t t-call="xsellence_portal.custom_layout">

            <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

            <!--========================|| Projects Here ||=========================-->
            <section class="projects-wrap mt-4 mt-sm-2">
                <div class="flex-between flex-wrap gap-4">
                    <div class="sec-title d-flex gap-2 align-center">Timesheets Tasks
                        <span
                                class="count fs-xs flex-center" t-esc="len(timesheets)">
                        </span>
                    </div>
                    <!-- add new timesheet button -->
                    <a class="btn btn-primary" href="/add_timesheet?source=timesheets">Add New Timesheet +</a>
                </div>


                <!-- Timesheets Cards Here -->
                <div class="timesheets-cards">
                    <div class="card">

                    </div>
                </div>

                <div class="timesheets mt-6">
                    <div class="filter-head flex-between gap-5">
                        <!-- For Search -->
                        <div class="search">
                            <div class="search-wrap input-control">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8">

                                    </circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65">

                                    </line>
                                </svg>
                                <input class="search-input" type="text" placeholder="Search Timesheet"/>
                            </div>
                        </div>

                        <!-- right -->
                        <div class="right d-flex gap-4 align-center">
                            <select class="filter-select" id="filter-project" onchange="applyFilters()">
                                <option value="">All Projects</option>
                                <option>MIT</option>
                                <option>Dashboard Project</option>
                                <option>NADIA FURNITURE</option>
                                <option>Ultimate Organic Life Ltd</option>
                                <option>MIT</option>
                                <option>Dashboard Project</option>
                                <option>NADIA FURNITURE</option>
                                <option>Ultimate Organic Life Ltd</option>
                                <option>Dashboard Project</option>
                            </select>

                            <!--  Filter By Month-->
                            <select class="filter-select" id="filter-month" onchange="applyFilters()">
                                <t t-foreach="month_options" t-as="month">
                                    <option t-att-value="month['value']"
                                            t-att-selected="'selected' if selected_month == month['value'] else None">
                                        <t t-esc="month['label']"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>


                    <!--=====================|| Timesheet Items Here (for 1 page show 12 or 15 items )  ||=======================-->
                    <div class="table-wrap mt-5 ">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Project</th>
                                    <th>Task</th>
                                    <th>Description</th>
                                    <th>Time Spent</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="timesheets" t-as="item">
                                    <tr>
                                        <td t-esc="item.date"></td>
                                        <td>
                                            <t t-esc="item.project_id.name or '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="item.task_id.name or '-'"/>
                                        </td>
                                        <td>
                                            <t t-esc="item.name or '-'"/>
                                        </td>
                                        <td>
                                            <span class="time-spent" t-field="item.unit_amount"
                                                  t-options="{'widget': 'float_time'}"/>
                                        </td>
                                        <td>
                                            <!-- Delete button -->
                                            <form method="post" action="/timesheets/delete">
                                                <input type="hidden" name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="timesheet_id" t-att-value="item.id"/>
                                                <button type="button" class="action-btn del"
                                                        onclick="return openDeleteModal(this)">
                                                    <svg width="12" height="12" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                        <path d="M10 11v6"/>
                                                        <path d="M14 11v6"/>
                                                        <path d="M9 6V4h6v2"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                </t>

                                <!--  When Empty Timesheets-->
                                <t t-if="not timesheets">
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-timesheet-box">
                                                <div class="empty-timesheet-icon">
                                                    <svg width="42" height="42" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="1.8"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                                                        <path d="M16 2v4"></path>
                                                        <path d="M8 2v4"></path>
                                                        <path d="M3 10h18"></path>
                                                        <path d="M9 15h6"></path>
                                                        <path d="M9 18h3"></path>
                                                    </svg>
                                                </div>

                                                <h4>No timesheets found</h4>
                                                <p>You have not submitted any timesheet yet.</p>

                                                <a href="/add_timesheet?source=timesheets" class="empty-timesheet-btn">
                                                    Add Timesheet
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                </t>

                                <!-- =====  Delete Modal  ===== -->
                                <div class="modal-overlay " id="deleteModal">
                                    <div class="modal-container">
                                        <div class="glass-icon">🗑️</div>
                                        <h3>Delete Timesheet?</h3>
                                        <p>
                                            This action cannot be undone.
                                            <br/>
                                            The timesheet will be permanently removed.
                                        </p>

                                        <div class="glass-actions">
                                            <button type="button" id="confirmYes" class="btn-glass-yes">
                                                Yes, Delete
                                            </button>
                                            <button class="btn-glass-no" onclick="closeModal('deleteModal')">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pagination -->
                <t t-if="len(timesheets) > 15">
                    <div class="pagination">
                        <span class="page-info">Showing 1–6 of 24 projects</span>
                        <div class="page-btns">
                            <button class="page-btn">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <polyline points="15 18 9 12 15 6"/>
                                </svg>
                            </button>
                            <button class="page-btn active">1</button>
                            <button class="page-btn">2</button>
                            <button class="page-btn">3</button>
                            <button class="page-btn">4</button>
                            <button class="page-btn">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </t>
            </section>
        </t>
    </template>
</odoo>