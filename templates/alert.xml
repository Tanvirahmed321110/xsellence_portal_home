<odoo>
    <!--==================||  For Success Page  ||=============== -->
    <template id="success_page">
        <t t-call="xsellence_portal.custom_layout">
            <!-- SUCCESS -->
            <div class="alert-wrap flex-center">
                <div class="submit-form flex-column align-center justify-center ">
                <div class="d5-wrap d5-success">
                    <div class="d5-icon-circle">🎯</div>
                    <div class="d5-divider"></div>
                    <h2>Project Successfully Created</h2>
                    <p>Your project is live and ready. Share it with your team or jump straight into tasks.</p>
                    <div class="d5-actions">
                        <a href="/projects" class="d5-btn-primary">Show Projects</a>
                        <a href="/dashboard" class="d5-btn-ghost">Back to Dashboard</a>
                    </div>
                </div>
            </div>
            </div>
        </t>
    </template>




    <!--==================||  For Error Page  ||=============== -->
    <template id="error_page">
        <t t-call="xsellence_portal.custom_layout">
            <!-- FAILED -->
           <div class="alert-wrap">
                <div class="submit-form flex-column align-center justify-center">
                <div class="d5-wrap d5-failed">
                    <div class="d5-icon-circle">🚫</div>
                    <div class="d5-divider"></div>
                    <h2>Submission Failed</h2>
                    <p>Your project could not be created at this time. Please review the errors below and try again.</p>
                    <div class="d5-actions">
                        <a href="#" class="d5-btn-primary">Retry</a>
                        <a href="#" class="d5-btn-ghost">Get Help</a>
                    </div>
                </div>
            </div>
           </div>
        </t>
    </template>
</odoo>









