<odoo>
    <template id="create_project_page">
        <link rel="stylesheet" href="/xsellence_portal/static/src/css/pages.css"/>
        <t t-call="xsellence_portal.custom_layout">

             <!-- ====================  Breadcrumb  ==================== -->
            <t t-call="xsellence_portal.breadcrumb_component"/>

             <!--========================|| Projects Here ||=========================-->
            <section class="projects-wrap mt-4 flex-column">
                <div class="sec-title d-flex gap-2 align-center">Add New Task <span
                        class="count fs-xs flex-center">+</span></div>


                <div class="d-flex flex-1 flex-center mt-6">
                    <form action="#" method="post" class="submit-form flex-column gap-5">
                        <div class="d-flex gap-3 align-center">
                            <div class="top flex-center">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                    <path d="M2 17l10 5 10-5"></path>
                                    <path d="M2 12l10 5 10-5"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="section-title head-primary">Add New Task</div>
                                <p class="desc mt-1">Add the details of your new task</p>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Project =======-->
                            <div class="input-control ">
                                <label for="">Project <span class="required">*</span></label>
                                <select name="" id="">
                                    <option value="Select Project">Select Project</option>
                                    <option value="">Project two</option>
                                    <option value="">Project Three</option>
                                    <option value="">Project Four</option>
                                </select>
                            </div>

                            <!--======= For Task Name =======-->
                            <div class="input-control">
                                <label for="">Task Name <span class="required">*</span></label>
                                <input type="text" placeholder="Task Name"/>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">

                            <!--======= For Assign Date =======-->
                            <div class="input-control">
                                <label for="">Assign Date</label>
                                <input type="date"/>
                            </div>

                            <!--======= For Assignees =======-->
                            <div class="input-control">
                                <label for="">Assignees</label>
                                <input type="date"/>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Allocation Hours =======-->
                            <div class="input-control">
                                <label for="">Allocation Hours <span class="required">*</span></label>
                                <input type="text" placeholder="Task Name"/>
                            </div>

                            <!--======= For Deadline =======-->
                            <div class="input-control">
                                <label for="">Deadline</label>
                                <input type="date"/>
                            </div>
                        </div>

                        <div class="grid-2 gap-5 grid-sm-1">
                            <!--======= For Allocation Hours =======-->
                            <div class="input-control ">
                                <label for="">Priority <span class="required">*</span></label>
                                <select name="" id="">
                                    <option value="Select Project">Select Priority</option>
                                    <option value="">Normal</option>
                                    <option value="">Medium</option>
                                    <option value="">High</option>
                                </select>
                            </div>
                            <!--======= For Status =======-->
                            <div class="input-control ">
                                <label for="">Task Status <span class="required">*</span></label>
                                <select name="" id="">
                                    <option value="Select Project">Pending</option>
                                    <option value="">In Progress</option>
                                    <option value="">Completed</option>
                                    <option value="">Canceled</option>
                                </select>
                            </div>
                            <!--======= For Assignee Names =======-->
                            <div class="input-control ">
                                <label for="">Assignee Names <span class="required">*</span></label>
                                <select id="assignees" multiple="multiple">
                                    <option value="1">Tanvir</option>
                                    <option value="2">Rahim</option>
                                    <option value="3">Karim</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid-1 gap-5 grid-sm-1">
                            <!--======= For Description =======-->
                            <div class="input-control">
                                <label for="">Description</label>
                                <textarea name="" id="" placeholder="Description..."></textarea>
                            </div>
                        </div>

                        <!-- <div id="toast" class="toast show error">
                            <span id="toast-msg">Submited Task</span>
                        </div> -->
                        <!-- <div id="toast" class="toast show success">
                            <span id="toast-msg">Error Message</span>
                        </div> -->


                        <!--======= For Rest and Sumbit Buttons =======-->
                        <div class="d-flex justify-end w-100 gap-4">
                            <!-- Reset button -->
                            <button class="btn btn-danger" type="reset">Reset

                                <svg width="16" height="14" viewBox="0 0 24 24" fill="none">
                                    <path d="M21 12a9 9 0 1 1-3-6.7" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" />
                                    <path d="M21 3v6h-6" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" />
                                </svg></button>
                            <!-- submit button -->
                            <button type="submit" class="btn btn-primary" style="gap:8px">Submit <svg width="12"
                                    height="12" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2 21l20-9L2 3v7l15 2-15 2z" />
                                </svg></button>
                        </div>

                    </form>
                </div>
            </section>
            <!-- Ts Control Library CDN -->
        <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
        <script>
            // <!-- Ts Control Library Code -->
            new TomSelect("#assignees", {
                create: true,   // allow new names
                persist: false
            });
        </script>
        </t>
    </template>
</odoo>