<odoo>
    <template id="projects_page">
        <t t-call="xsellence_portal.custom_layout">

             <!-- ====================  Breadcrumb  ==================== -->
            <div class="flex-between align-center gap-1 flex-wrap n-btn-wrap">
                <t t-call="xsellence_portal.breadcrumb_component"/>
                <a href="/create_project?source=projects" class="btn btn-primary"> Create Project +</a>
            </div>

            <!--========================|| Projects Here ||=========================-->
            <section class="projects-wrap mt-4">

               <!--================||   Filter Header ||===============-->
               <div class="flex-between  gap-5 row-gap-2" style="overflow-x: auto;">
                    <div class="sec-title d-flex gap-2 align-center flex-1 text-nowrap">Projects
                        <span class="count fs-xs flex-center">
                            <t t-esc="len(projects)"/>
                        </span>
                    </div>

                    <div class="search task-search">
                        <div class="search-wrap  input-control shadow-md">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input class="search-input" type="text" placeholder="Search task name or id..."/>
                        </div>
                    </div>

                    <div class="flex-1 d-flex justify-end">
                        <select class="filter-select bg-white  " id="filter-month">
                            <option value="">All Status</option>
                            <option value="">Pending</option>
                            <option value="2025-04">Complted</option>
                            <option value="2025-04">In Progress</option>
                            <option value="2025-04">Done</option>
                            <option value="2025-04">Other</option>
                        </select>
                    </div>
                </div>

                <!--==============================|| All Projects Here ||============================-->
                <div
                        class="grid-4 grid-lg-4 gap-lg-4 row-gap-lg-5 gap-6 grid-sm-1 row-gap-sm-4 grid-md-2 projects mt-5 mt-sm-5 gap-sm-3">

                    <!--================||   Single Project Card here ||===============-->
                    <t t-foreach="projects" t-as="project">
                        <div class="proj-card">
                        <div class="card-banner"></div>
                        <div class="card-body">
                            <div class="card-top">
                                <div class="card-title-wrap">
                                    <!-- Project Name -->
                                    <div class="card-proj-name" >
                                        <t t-esc="project.name"/>
                                        <!-- Total Tasks -->
                                        <span
                                                class="info-val tasks-num ">2
                                        </span>
                                    </div>
                                </div>
                                <!-- Status -->
                                <span class="status-badge status-active"><span class="dot"></span>
                                    <t t-esc="project.custom_status"/>
                                </span>
                            </div>
                            <!-- tags -->
                            <div class="card-tags">
                                <t t-foreach="project.tag_ids" t-as="tag" t-key="tag.id">
                                    <span class="tag" t-esc="tag.name">Mobile</span>
                                </t>
                            </div>
                            <div class="card-info-grid mt-2">

                                <!-- customer -->
                                <div class="info-item">
                                    <div class="info-label">Customer</div>
                                    <div class="info-val mt-1" t-esc="project.partner_id.name">ByteTech Ltd
                                    </div>
                                </div>
                                <!-- Planned Date -->
                                <div class="info-item">
                                    <div class="info-label">Planned Date</div>
                                    <div class="info-val mt-1">
                                        <svg width="11" height="11" viewBox="0 0 24 24"
                                             fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <t t-esc="project.date_start"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card-info-grid">
                                <div class="card-manager">

                                    <!-- Project Manager -->
                                    <div class="manager-info">
                                        <div class="info-label">Project Manager</div>
                                        <div class="manager-name" t-esc="project.user_id.name">Nadia Islam</div>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <!-- Allocated Time -->
                                    <div class="info-label">Allocated Time</div>
                                    <div class="info-val mt-1">
                                        <svg width="11" height="11" viewBox="0 0 24 24"
                                             fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <span t-esc="project.allocated_hours">Working days</span>Hours
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ======= Card Footer ======== -->
                        <div class="card-footer flex-wrap row-gap-3">
                            <div class="deadline-wrap">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9ca3af"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                <!-- deadline -->
                                <div>
                                    <div class="deadline-date" t-esc="project.date">20 May 2026</div>
                                    <div class="deadline-left"> <t t-esc="project.remaining_days"/> days</div>
                                </div>
                            </div>

                            <!-- ======== Card Btns ======= -->
                            <div class="action-btns">
                                <!-- View Task -->
                                <a href="/tasks.html" class="action-btn view-task-btn tooltip">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                        <path d="M9 11L12 14L20 6" stroke="currentColor" stroke-width="2"
                                              stroke-linecap="round" stroke-linejoin="round"/>
                                        <path
                                                d="M20 12V19C20 20.1046 19.1046 21 18 21H5C3.89543 21 3 20.1046 3 19V6C3 4.89543 3.89543 4 5 4H16"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round"/>
                                    </svg>
                                    Tasks
                                    <span class="tooltip-text">View All Tasks</span>
                                </a>

                                <!-- View Project -->
                                <a t-att-href=" '/projects/details/%s' % project.id " class="action-btn btn-primary tooltip">View
                                    <svg width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <span class="tooltip-text">View Project</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    </t>

